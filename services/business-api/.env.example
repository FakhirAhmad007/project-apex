# Local Postgres by default. For Supabase, use the connection string from
# Project Settings > Database > Connection string (URI), with sslmode=require.
DATABASE_URL=postgresql+psycopg2://postgres:Rihkaf1@localhost:5432/project_apex

JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Where this service can reach the AI service (Intern 1's service).
AI_SERVICE_URL=http://localhost:8001

# Comma-separated list is not supported by pydantic-settings list parsing from
# .env directly — for multiple origins, set CORS_ORIGINS as a JSON array string,
# e.g. CORS_ORIGINS=["http://localhost:3000","https://your-app.vercel.app"]
CORS_ORIGINS=["http://localhost:3000"]
